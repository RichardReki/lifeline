# KeeperHub org API key (Settings > API Keys > Organisation tab, starts with kh_)
KH_API_KEY=
KH_BASE_URL=https://app.keeperhub.com
# KeeperHub network id the agent executes on: "sepolia" | "base"
# (day1-verify prints the authoritative ids from GET /api/chains)
KH_NETWORK=sepolia
# KeeperHub org wallet that signs executions — enables the live allowance
# pre-check before approve; leave empty to conservatively approve every rescue
KH_WALLET_ADDRESS=

# Networks
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC=https://mainnet.base.org

# Deployed HealthFactorLens (filled after forge deploy — see contracts/DEPLOY.md)
LENS_ADDRESS_SEPOLIA=
LENS_ADDRESS_BASE=

# Aave v3 Pool addresses (verified in contracts/addresses.md)
AAVE_POOL_SEPOLIA=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
AAVE_POOL_BASE=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# The wallet position we guard (KeeperHub org wallet or demo EOA)
GUARDED_ACCOUNT=

# Agent webhook server
WEBHOOK_PORT=8787
# Shared secret the KeeperHub webhook must present (X-Lifeline-Secret header)
WEBHOOK_SECRET=change-me

# Rescue policy
HF_WARN_THRESHOLD=1.3
HF_TARGET=1.5
# Early-warning horizon for the HF trajectory projection (seconds)
HF_HORIZON_SECONDS=3600
# Local poll loop interval / minimum gap between rescues (milliseconds)
POLL_INTERVAL_MS=60000
RESCUE_COOLDOWN_MS=300000

# ---------------------------------------------------------------------------
# Rescue market — REQUIRED for the agent to plan a rescue (planner inputs).
# Addresses below are the Sepolia Aave v3 test market (contracts/addresses.md);
# for Base use USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (6 dec) and
# WETH 0x4200000000000000000000000000000000000006 (18 dec).
# ---------------------------------------------------------------------------
# Asset the "repay" rescue spends (the borrowed asset)
DEBT_ASSET_ADDRESS=0x94a9D9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8
DEBT_ASSET_SYMBOL=USDC
DEBT_ASSET_DECIMALS=6
# Fallback price when no AAVE_ORACLE is set: 8-dec USD per whole token (1 USDC = 1e8)
DEBT_ASSET_PRICE_BASE=100000000
# Asset the "supply" rescue deposits (the collateral asset)
COLLATERAL_ASSET_ADDRESS=0xC558DBdd856501FCd9aaF1E62eae57A9F0629a3c
COLLATERAL_ASSET_SYMBOL=WETH
COLLATERAL_ASSET_DECIMALS=18
COLLATERAL_ASSET_PRICE_BASE=
# Optional: Aave oracle (getAssetPrice, 8-dec USD) — overrides *_PRICE_BASE live
AAVE_ORACLE_SEPOLIA=
AAVE_ORACLE_BASE=
